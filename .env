# Copy this file to .env and adjust values. Keep .env out of version
# control (add it to .gitignore) since it holds the DB password.

CITYDB_PASSWORD=changeMe
CITYDB_SRID=25832
CITYDB_PORT=5432

# Set to "true" (temporarily) to force lcz-init to re-run the setup
# scripts even if the lcz schema already exists — useful while you are
# still iterating on the SQL scripts. Leave "false" in normal operation.
LCZ_FORCE_REINIT=false
